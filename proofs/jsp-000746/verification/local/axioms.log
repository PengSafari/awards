Jsp746.integer_graph (G : SimpleGraph ℤ) (hG : G.CliqueFree 3) :
  ∃ a b, 0 < a ∧ a < b ∧ b < a + b ∧ a + b ≤ 18 ∧ ¬G.Adj a b ∧ ¬G.Adj a (a + b) ∧ ¬G.Adj b (a + b)
Jsp746.finite_threshold (n : ℕ) : Jsp746.FiniteSchurProperty n ↔ 18 ≤ n
